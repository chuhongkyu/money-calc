{
  "name": "salary-calc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:web": "VITE_TARGET=web pnpm build",
    "build:app": "VITE_TARGET=app pnpm build && npx cap sync",
    "preview": "vite preview",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "licenses": "node scripts/generate-licenses.mjs",
    "og": "node scripts/generate-og-image.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@karrotmarket/react-monochrome-icon": "^1.27.0",
    "@seed-design/css": "^2.8.3",
    "@seed-design/react": "^2.5.0",
    "@seed-design/stackflow": "^2.0.4",
    "@stackflow/config": "^2.0.0",
    "@stackflow/core": "^3.1.0",
    "@stackflow/plugin-history-sync": "^2.1.0",
    "@stackflow/plugin-renderer-basic": "^1.1.16",
    "@stackflow/react": "^2.1.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@seed-design/vite-plugin": "^2.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
